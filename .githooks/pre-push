#!/bin/sh
set -eu

seen=" "
while read -r local_ref oid remote_ref remote_oid; do
  # Ignore branch deletions and tags pointing to blobs or trees.
  case "$oid" in *[!0]*) ;; *) continue ;; esac
  commit=$(git rev-parse --verify --quiet "$oid^{commit}") || continue
  case "$seen" in *" $commit "*) continue ;; esac
  "$(dirname "$0")/validate-tree" "$commit"
  seen="$seen$commit "
done
